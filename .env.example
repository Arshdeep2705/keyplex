# Optional — paste a Google Maps JavaScript API key to upgrade every listing map
# from the free CARTO/Esri tiles to full Google Maps (incl. Street View).
# Create one at https://console.cloud.google.com (enable "Maps JavaScript API";
# the monthly free credit covers ~28k map loads). Then rebuild + redeploy.
VITE_GOOGLE_MAPS_KEY=

# Supabase overrides (defaults are baked in — these are public client keys)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
